# ---------- 应用 ----------
APP_NAME=xuanwu-shop
APP_ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# ---------- 数据库 ----------
# 全程 PostgreSQL，连接串必填（缺失会导致启动失败）
DATABASE_URL=postgresql+psycopg://xuanwu:xuanwu@127.0.0.1:5432/xuanwu

# ---------- JWT ----------
# 生产环境必须替换为高强度随机值，且不得提交到仓库
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# 24 小时（需求 §2.5）
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ---------- CORS（逗号分隔） ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 密码 ----------
BCRYPT_ROUNDS=12

# ---------- 订单超时任务（M4 启用） ----------
ORDER_EXPIRE_JOB_ENABLED=false
ORDER_EXPIRE_MINUTES=30
ORDER_AUTO_CONFIRM_DAYS=15

# ---------- 智能客服（可选） ----------
# 留空 API_KEY 时使用内置规则引擎，功能可完整演示；
# 填入任意 OpenAI 兼容服务的 Key 即切换为真实模型（DeepSeek / 通义 / OpenAI）。
SUPPORT_LLM_BASE_URL=https://api.deepseek.com/v1
SUPPORT_LLM_API_KEY=
SUPPORT_LLM_MODEL=deepseek-chat
SUPPORT_LLM_TEMPERATURE=0.3
SUPPORT_LLM_TIMEOUT=30
